APP_ENV=development
API_ADDR=:8080
DATABASE_URL=app:app@tcp(mysql:3306)/multilanguage?parseTime=true&charset=utf8mb4&collation=utf8mb4_unicode_ci
REDIS_URL=redis://redis:6379/0
CORS_ALLOWED_ORIGINS=http://localhost:3000
DEMO_USER_ID=00000000-0000-0000-0000-000000000001
ALLOW_DEMO_AUTH=true
AUTH_ACCESS_TTL_SECONDS=900
AUTH_REFRESH_TTL_DAYS=30
AUTH_REFRESH_COOKIE=lingua_refresh
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:3000/api/auth/google/callback
DICTIONARY_CACHE_TTL_SECONDS=300
DASHBOARD_CACHE_TTL_SECONDS=60

# Frontend server-side rewrite target. Use http://localhost:8080 outside Compose.
BACKEND_URL=http://backend:8080

# Demo accounts seeded by migrations 001-006 (fresh database only):
#   admin@gmail.com         / @Admin123    -> admin console at /admin
#   admin@lingua.dev        / Admin1234    -> admin console at /admin
#   minh.anh@lingua.dev     / Teacher1234  -> instructor studio at /instructor
#   sofia.reyes@lingua.dev  / Teacher1234  -> instructor studio at /instructor
#   learner@example.com     / Learner1234  -> learner app at /app
#   linh@example.com        / Learner1234  -> learner app at /app

# AI/speech providers are intentionally server-side only.
AI_PROVIDER=local
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://host.docker.internal:11434
STT_PROVIDER=
TTS_PROVIDER=
PRONUNCIATION_PROVIDER=
